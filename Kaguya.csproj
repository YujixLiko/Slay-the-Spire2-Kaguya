<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>3.2.4</Version>
    <AssemblyVersion>3.2.4.0</AssemblyVersion>
    <FileVersion>3.2.4.0</FileVersion>
    <!-- 合并工程才有「酒寄彩叶」角色：独立辉夜 mod 不定义此常量 -->
    <DefineConstants>$(DefineConstants);HAS_SAKAYORI</DefineConstants>
  </PropertyGroup>
  
  <Target Name="CopyCustomOutput" AfterTargets="Build">
    <ItemGroup>
      <OutputDlls Include="$(OutputPath)\$(AssemblyName).dll" />
      <OutputDlls Include="$(OutputPath)\$(AssemblyName).pdb" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)\build" />
    <Copy SourceFiles="@(OutputDlls)" DestinationFolder="$(MSBuildProjectDirectory)\build" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Kaguya\Kaguya.json" DestinationFolder="$(MSBuildProjectDirectory)\build" />
 </Target>
  
  <ItemGroup>
    <Compile Remove="build/**/*.cs" />

	<Reference Include="0Harmony">
	  <HintPath>libs\0Harmony.dll</HintPath>
	</Reference>

	<Reference Include="BaseLib">
		<HintPath>$(Sts2Dir)/mods/BaseLib/BaseLib.dll</HintPath>
		<Private>false</Private>
	</Reference>

	<Reference Include="sts2">
	  <HintPath>libs\sts2.dll</HintPath>
	</Reference>
	  <!-- NuGet获取，注意版本是否一致，不一致手动更改Version -->
	  <PackageReference Include="Alchyr.Sts2.BaseLib" Version="*" />
  </ItemGroup>
</Project>
